{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    /*
     * `esnext` + `bundler`, igual que el proyecto de la aplicación.
     * Estaba en `nodenext`, que exige extensiones `.js` explícitas
     * en cada import: desde que vite.config.ts importa la marca
     * desde `src/marca/`, eso obligaba a escribir los imports de
     * ese directorio de una forma distinta al resto de `src/`.
     */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts"]
}
